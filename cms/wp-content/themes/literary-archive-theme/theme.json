{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "background", "name": "Off-white", "color": "#f5f0e6" },
				{ "slug": "surface", "name": "Surface", "color": "#fdfbf6" },
				{ "slug": "text", "name": "Charcoal", "color": "#2a2420" },
				{ "slug": "text-muted", "name": "Muted text", "color": "#6d6153" },
				{ "slug": "accent", "name": "Burgundy", "color": "#6e2340" }
			],
			"custom": false
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Noto Serif Bengali",
					"fontFamily": "\"Noto Serif Bengali\", Georgia, \"Noto Serif\", serif"
				},
				{
					"slug": "sans",
					"name": "Noto Sans Bengali",
					"fontFamily": "\"Noto Sans Bengali\", \"Noto Sans\", system-ui, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.05rem" },
				{ "slug": "large", "name": "Large", "size": "1.6rem" },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.4rem" }
			]
		},
		"spacing": {
			"units": [ "rem", "em", "%" ]
		}
	}
}
