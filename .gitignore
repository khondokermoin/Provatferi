# --- Credentials -----------------------------------------------------------
# A WordPress config holds live database credentials and auth salts. One was
# committed by accident in 2026-09; never again, anywhere in the tree.
**/wp-config.php
.env
.env.*
!.env.example
*.pem
*.ppk
id_rsa
id_rsa.*
.super-admin-credentials.txt
*credentials*.txt

# --- Deployed site copies --------------------------------------------------
# These live on the host and are deployed by direct sync, not from this repo.
# poem-archive (public_html/wp-content/…) is its own repository with its own
# remote — keep it that way rather than nesting it here.
/public_html/
/cms/

# --- Vendor bundles --------------------------------------------------------
# Purchased admin theme; not our source.
/Zircos_v4.0/

# --- Binary design and specification documents -----------------------------
# Belong in shared storage. They bloat history permanently and never diff.
*.psd
*.docx
*.pdf
*.zip

# --- Local tooling ---------------------------------------------------------
node_modules/
vendor/
.DS_Store
Thumbs.db
