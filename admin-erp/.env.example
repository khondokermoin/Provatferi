APP_NAME="Provatferi ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production: APP_URL=https://admin.provatferi.org, APP_ENV=production, APP_DEBUG=false

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL only (2026-09-08 policy). SQLite is not approved for this project at
# any stage — the production target is MySQL and the schema relies on real FK
# enforcement, JSON validation and utf8mb4 collation.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=provatferi_admin_dev
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Local test database (see phpunit.xml): provatferi_admin_test

# Production (admin.provatferi.org) — password is never committed here:
# DB_CONNECTION=mysql
# DB_HOST=srv1515.hstgr.io
# DB_PORT=3306
# DB_DATABASE=u951246149_admin_erp
# DB_USERNAME=u951246149_admin_erp
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail -------------------------------------------------------------------
# Local/dev default is `log` so nothing is ever sent by accident. Production
# sets MAIL_MAILER=smtp.
#
# Hostinger Email (verified 2026-09-09 against the live provatferi.org zone and
# by probing the SMTP endpoints directly — MX is mx1/mx2.hostinger.com):
#
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465  MAIL_SCHEME=smtps   implicit TLS  <- preferred
#   MAIL_PORT=587  MAIL_SCHEME=smtp    STARTTLS      <- fallback
#
# Both advertise AUTH PLAIN LOGIN. Prefer 465/smtps: TLS is established before
# the SMTP conversation starts, so there is no cleartext window to downgrade.
# Laravel 12 uses MAIL_SCHEME; MAIL_ENCRYPTION is legacy and is ignored here.
#
# MAIL_USERNAME is always the full mailbox address. Each mailbox has its own
# password — a mailbox password is NOT the hosting account password.
#
# Mailbox roles (see docs/MAIL_ROLES.md for the full mapping):
#   no-reply@  automated/transactional sender  <- MAIL_FROM_ADDRESS
#   info@      public contact, default human reply-to
#   support@   member/account/application help
#   security@  security reports and alerts
#   admin@     internal ERP login + operational notices, never public-facing
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@provatferi.org"
MAIL_FROM_NAME="Provatferi Literary and Cultural Center"

# Reply-To targets by message class. Automated mail is sent FROM no-reply@ but
# must always give a human a real address to reply to.
MAIL_REPLY_TO_ADDRESS="info@provatferi.org"
MAIL_REPLY_TO_SUPPORT="support@provatferi.org"
MAIL_REPLY_TO_SECURITY="security@provatferi.org"
MAIL_OPERATIONS_ADDRESS="admin@provatferi.org"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
