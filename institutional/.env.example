# Base URL of the Laravel ERP's public API (admin.provatferi.org).
#
# Deliberately NOT prefixed NEXT_PUBLIC_ — every lib/api/*.ts call runs
# server-side only (see lib/api/client.ts, which imports "server-only" to
# make this a build error to violate), so the browser never needs this value
# and it never ships in a client bundle. Do not rename this to a
# NEXT_PUBLIC_ variant unless a real client-side use case requires it.
LARAVEL_API_URL="https://admin.provatferi.org"

# Shared HMAC secret for POST /api/revalidate (app/api/revalidate/route.ts),
# which admin-erp calls after every homepage-carousel change so the live site
# updates in seconds instead of after the 120s fetch window. It must be the
# SAME value as admin-erp's REVALIDATE_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Server-side only, deliberately NOT NEXT_PUBLIC_: the secret is only ever used
# to sign/verify and is never transmitted. Leave unset locally — the route then
# answers 503 and Laravel (which skips the call when its own copy is unset)
# simply never invokes it. In production this is set in Hostinger's Node.js
# environment variables, never committed. To rotate, change it in both places.
REVALIDATE_SECRET=
